<?xml version="1.0"?>
<ruleset name="Kumiai">
    <description>WordPress Coding Standards for the Kumiai theme.</description>

    <file>wp-content/themes/kumiai-theme</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="4"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- Target WP 6.0+ and PHP 8.0+ -->
    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="8.0-"/>

    <rule ref="WordPress">
        <!-- Inline styles/scripts are intentional in this theme (TOC JS, hero CTAs) — would refactor as a separate task. -->
        <exclude name="WordPress.WP.EnqueuedResources"/>

        <!-- The theme uses concise inline templates; full file headers are noise here. -->
        <exclude name="Squiz.Commenting.FileComment"/>
        <exclude name="Squiz.Commenting.FunctionComment"/>
        <exclude name="Squiz.Commenting.ClassComment"/>
        <exclude name="Squiz.Commenting.VariableComment"/>

        <!-- Allow Yoda-free conditions; modern PHP doesn't need this defensive style. -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Theme is single-locale (Japanese) — no i18n yet. Re-enable when adding translations. -->
        <exclude name="WordPress.WP.I18n"/>

        <!-- The hardcoded slugs/titles are demo content, not translatable strings. -->
        <exclude name="Generic.Files.LineLength"/>

        <!-- Comment ending punctuation is a style preference; comments are bilingual VN/JP/EN here. -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
    </rule>

    <!-- Fail CI on errors only; warnings are advisory. -->
    <arg name="severity" value="1"/>
    <arg name="error-severity" value="5"/>
    <arg name="warning-severity" value="0"/>
</ruleset>
