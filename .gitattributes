# Normalize line endings across all platforms.
# PHP / Bash / YAML / Markdown sources stay LF in the working tree, regardless of
# autocrlf settings on Windows. Prevents PHPCS "End of line character is invalid"
# noise when running CI through a Linux container on a Windows host.
* text=auto eol=lf

# Binary files: never touch them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
