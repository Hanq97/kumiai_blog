# ===== Database =====
DB_ROOT_PASSWORD=your_secure_root_password_123
DB_NAME=wordpress
DB_USER=wordpress_user
DB_PASSWORD=your_secure_password_abcxyz
# Host port exposed for local DB GUIs (bound to 127.0.0.1 only).
DB_PORT=3306

# ===== Site URL =====
# Local dev: http://localhost:8000
# Production: https://your-domain.example.com (must match how visitors access the site)
WP_HOME=http://localhost:8000
WP_SITEURL=http://localhost:8000

# ===== Public port (host side) =====
# Local: 8000. Behind reverse proxy (Caddy/nginx): keep 8000 and have the proxy forward to it,
# or bind only to loopback by setting e.g. 127.0.0.1:8000 in docker-compose.yml ports.
WP_PORT=8000

# ===== Environment mode =====
# development -> WP_DEBUG on, debug.log enabled, auto-seed demo posts on first boot
# production  -> WP_DEBUG off, FORCE_SSL_ADMIN on, demo-content seeding skipped
# Always set KUMIAI_ENV=production before the first start on a real server.
KUMIAI_ENV=development

# ===== Dynamic site URL =====
# Set to 1 when sharing this local dev server through a tunnel (VSCode devtunnels,
# ngrok, cloudflared, ...) so WordPress builds asset URLs from the request's
# Host header instead of the hard-coded WP_HOME. Leave at 0 on production —
# host-header attacks are real and prod should pin the URL.
KUMIAI_DYNAMIC_URL=0
